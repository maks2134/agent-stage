# Optional: without a key the API runs the deterministic mock pipeline.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated list of frontend origins ("*" allows any).
ALLOWED_ORIGINS=http://localhost:3000

# PORT (set by Render/Fly) wins over ADDR.
ADDR=:8084
